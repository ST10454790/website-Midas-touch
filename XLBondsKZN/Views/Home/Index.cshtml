@{
    ViewData["Title"] = "Home";
}

<!-- ==========================================
                HERO SECTION
========================================== -->

<section class="hero" id="home">

    <div class="hero-container">

        <div class="hero-content">

            <span class="hero-tag">
                Trusted Home Loan Specialists
            </span>

            <h1>
                Helping You Secure the Right Home Loan
            </h1>

            <p>
                At XLBonds KZN, we make the home loan process simple, secure and
                stress-free. We work with leading financial institutions to help
                South Africans find the right financing solution.
            </p>

            <a href="#calculator" class="hero-btn">

                Calculate Your Affordability

            </a>

        </div>

        <div class="hero-image">

            <img src="~/images/hero-image.png"
                 alt="Home Loan Illustration" />

        </div>

    </div>

</section>

<!-- ==========================================
            WHY CHOOSE US
========================================== -->

<section class="page-header" id="why-choose-us">

    <h1>Why Choose Us</h1>

    <p>
        Your trusted partner in securing the perfect home loan.
    </p>

</section>

<section class="cards">

    <div class="card">

        <div class="icon-box">
            <i class="bi bi-award"></i>
        </div>

        <h3>Excellence in Service</h3>

        <p>
            We are committed to providing professional and reliable home loan
            solutions tailored to every client.
        </p>

    </div>

    <div class="card">

        <div class="icon-box">
            <i class="bi bi-people-fill"></i>
        </div>

        <h3>Customer Satisfaction</h3>

        <p>
            Our clients remain our priority throughout every stage of the home
            loan application process.
        </p>

    </div>

    <div class="card">

        <div class="icon-box">
            <i class="bi bi-trophy"></i>
        </div>

        <h3>Industry Recognition</h3>

        <p>
            We strive to deliver trusted financial services through recognised
            industry best practices.
        </p>

    </div>

    <div class="card">

        <div class="icon-box">
            <i class="bi bi-patch-check"></i>
        </div>

        <h3>Professional Standards</h3>

        <p>
            Integrity, transparency and professionalism are at the centre of
            every client interaction.
        </p>

    </div>

    <div class="card">

        <div class="icon-box">
            <i class="bi bi-bank"></i>
        </div>

        <h3>Leading Banking Partners</h3>

        <p>
            We work alongside South Africa's leading financial institutions to
            secure competitive home loan options.
        </p>

    </div>

    <div class="card">

        <div class="icon-box">
            <i class="bi bi-headset"></i>
        </div>

        <h3>Dedicated Support</h3>

        <p>
            Our experienced consultants provide guidance from application to
            approval.
        </p>

    </div>

</section>

<!-- ==========================================
              OUR SERVICES
========================================== -->

<section class="page-header" id="services">

    <h1>Our Services</h1>

    <p>
        Professional home loan services designed around your needs.
    </p>

</section>

<section class="cards">

    <div class="card">

        <div class="icon-box">
            <i class="bi bi-house-door"></i>
        </div>

        <h3>Home Loan Applications</h3>

        <p>
            Helping clients obtain the right home loan through trusted banking
            partners.
        </p>

    </div>

    <div class="card">

        <div class="icon-box">
            <i class="bi bi-bank2"></i>
        </div>

        <h3>Bond Applications</h3>

        <p>
            Professional assistance with preparing and submitting bond
            applications.
        </p>

    </div>

    <div class="card">

        <div class="icon-box">
            <i class="bi bi-file-earmark-text"></i>
        </div>

        <h3>Document Assistance</h3>

        <p>
            Guidance on preparing and submitting all required supporting
            documentation.
        </p>

    </div>

    <div class="card">

        <div class="icon-box">
            <i class="bi bi-graph-up-arrow"></i>
        </div>

        <h3>Financial Guidance</h3>

        <p>
            Helping you understand your affordability and available financing
            options.
        </p>

    </div>

    <div class="card">

        <div class="icon-box">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h3>Secure Processing</h3>

        <p>
            Your personal information is handled securely and confidentially at
            every stage.
        </p>

    </div>

    <div class="card">

        <div class="icon-box">
            <i class="bi bi-chat-dots"></i>
        </div>

        <h3>Professional Consultation</h3>

        <p>
            Friendly, knowledgeable consultants available to answer your home
            loan questions.
        </p>

    </div>

</section>

<!-- ==========================================
            PLACEHOLDER SECTIONS
========================================== -->

<section class="page-header" id="calculator">

    <h1>Affordability Calculator</h1>

    <p>
        Calculator functionality will be integrated in a future phase.
    </p>

</section>

<section class="page-header" id="documents">

    <h1>Upload Documents</h1>

    <p>
        Secure document upload functionality will be added by the backend team.
    </p>

</section>

<section class="page-header" id="advice">

    <h1>Tips & Advice</h1>

    <p>
        Helpful home buying tips and financial advice will be available here.
    </p>

</section>