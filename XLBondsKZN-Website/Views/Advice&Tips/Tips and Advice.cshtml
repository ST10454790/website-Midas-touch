@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Tips & Advice</title>

    <link rel="stylesheet" href="~/css/site.css">

    <!--google fonts  -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>

    <section class="tips-section">
        <div class="section-header">
            <h1>Tips & Advice</h1>
            <p>Expert insights to help you navigate your home buying journey</p>
        </div>
        @* cards dont go into anything for now they are statics *@
        <div class="cards-container">

            <!--1st Card -->
            <article class="tip-card">

                <div class="card-icon">
                    @* svg for the house icon  *@
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="15"
                         height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="lucide lucide-house">

                        <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
                        <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    </svg>
                </div>

                <div class="card-content">

                    <span class="category">Buying Guide</span>

                    <h2>First-Time Home Buyer Guide</h2>
                    <p>
                        Everything you need to know about purchasing your first
                        property in South Africa.
                    </p>

                    <a href="#" class="read-more">
                        Read More
                        <span>→</span>
                    </a>

                </div>

            </article>

            <!-- 2nd Card-->
            <article class="tip-card">

                <div class="card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" 
                    width="24" height="24" viewBox="0 0 24 24" 
                    fill="none" stroke="currentColor" stroke-width="2" 
                    stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-narrow-wide">
                    <path d="m3 8 4-4 4 4" /><path d="M7 4v16" /><path d="M11 12h4" /><path d="M11 16h7" />
                    <path d="M11 20h10" /></svg>
                    </svg>
                </div>

                <div class="card-content">

                    <span class="category">Financial Tips</span>

                    <h2>Understanding Interest Rates</h2>

                    <p>
                        How interest rates affect your home loan and what to look
                        for when comparing offers.
                    </p>

                    <a href="#" class="read-more">
                        Read More
                        <span>→</span>
                    </a>

                </div>

            </article>

            <!--3rd card  -->
            <article class="tip-card">

                <div class="card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg"
                width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield">
                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /></svg>
                
                </div>

                <div class="card-content">

                    <span class="category">Credit Advice</span>

                    <h2>Improving Your Credit Score</h2>

                    <p>
                        Essential steps to improve your credit rating before
                        applying for a home loan.
                    </p>

                    <a href="#" class="read-more">
                        Read More
                        <span>→</span>
                    </a>

                </div>

            </article>

            <!--4th card-->
            <article class="tip-card">

                <div class="card-icon">
                <svg xmlns="http://www.w3.org/2000/svg"
                width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield">
                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /></svg>
                </div>

                <div class="card-content">

                    <span class="category">Documentation</span>

                    <h2>Bond Application Checklist</h2>

                    <p>
                        A comprihensive checklist of documents and requirements
                        for your bond application.
                    </p>

                    <a href="#" class="read-more">
                        Read More
                        <span>→</span>
                    </a>

                </div>

            </article>

        </div>

    </section>

</body>
</html>